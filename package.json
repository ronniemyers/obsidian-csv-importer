{
  "name": "obsidian-csv-importer",
  "version": "1.0.2",
  "description": "Import CSV files to create notes",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit && node esbuild.config.mjs production",
    "bump": "node version-bump.mjs && git add package.json manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "csv",
    "typescript"
  ],
  "author": "Ronnie Myers",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^20.0.0",
    "@types/papaparse": "^5.3.16",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "globals": "^16.4.0",
    "obsidian": "latest",
    "tslib": "^2.4.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "papaparse": "^5.4.1"
  }
}
